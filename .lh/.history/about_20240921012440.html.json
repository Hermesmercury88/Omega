            "content": "<!DOCTYPE html>\r\n<html>\r\n\r\n<head>\r\n  <!-- Basic -->\r\n  <meta charset=\"utf-8\" />\r\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\r\n  <!-- Mobile Metas -->\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\" />\r\n  <!-- Site Metas -->\r\n  <meta name=\"keywords\" content=\"\" />\r\n  <meta name=\"description\" content=\"\" />\r\n  <meta name=\"author\" content=\"\" />\r\n\r\n  <title>Hollywood</title>\r\n\r\n  <!-- favicon -->\r\n  <link rel=\"icon\" type=\"image/x-icon\" href=\"images/logo.png\" />\r\n\r\n  <!-- slider stylesheet -->\r\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css\" />\r\n\r\n  <!-- bootstrap core css -->\r\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"css/bootstrap.css\" />\r\n\r\n  <!-- fonts style -->\r\n  <link href=\"https://fonts.googleapis.com/css?family=Baloo+Chettan|Dosis:400,600,700|Poppins:400,600,700&display=swap\" rel=\"stylesheet\" />\r\n  <!-- Custom styles for this template -->\r\n  <link href=\"css/style.css\" rel=\"stylesheet\" />\r\n  <!-- responsive style -->\r\n  <link href=\"css/responsive.css\" rel=\"stylesheet\" />>\r\n</head>\r\n\r\n<body class=\"sub_page\">\r\n  <div class=\"hero_area\">\r\n    <!-- header section strats -->\r\n    <header class=\"header_section\">\r\n      <div class=\"container\">\r\n        <div class=\"header_nav\">\r\n          <a class=\"navbar-brand brand_desktop\" href=\"index.html\">\r\n            <img src=\"images/logo.png\" alt=\"\" />\r\n          </a>\r\n          <div class=\"main_nav\">\r\n            \r\n            \r\n            <div class=\"bottom_nav\">\r\n              <nav class=\"navbar navbar-expand-lg custom_nav-container\">\r\n                <a class=\"navbar-brand brand_mobile\" href=\"index.html\">\r\n                  <img src=\"images/logo.png\" alt=\"\" />\r\n                </a>\r\n                <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\r\n                  <span class=\"navbar-toggler-icon\"></span>\r\n                </button>\r\n                <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\r\n                  <div class=\"d-flex ml-auto flex-column flex-lg-row align-items-center\">\r\n                    <ul class=\"navbar-nav  \">\r\n                      <li class=\"nav-item active\">\r\n                        <a class=\"nav-link\" href=\"index.html\">Home <span class=\"sr-only\">(current)</span></a>\r\n                      </li>\r\n                      <li class=\"nav-item\">\r\n                        <a class=\"nav-link\" href=\"about.html\"> About </a>\r\n                      </li>\r\n                      <li class=\"nav-item\">\r\n                        <a class=\"nav-link\" href=\"information.html\"> information </a>\r\n                      </li>\r\n                      <li class=\"nav-item\">\r\n                        <a class=\"nav-link\" href=\"personnel.html\">Personnel</a>\r\n                      </li>\r\n                    </ul>\r\n                    <form class=\"form-inline\">\r\n                      <button class=\"btn ml-3 ml-lg-5 nav_search-btn\" type=\"submit\"></button>\r\n                    </form>\r\n                  </div>\r\n                </div>\r\n              </nav>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </header>\r\n    <!-- end header section -->\r\n  </div>\r\n\r\n <!-- about section -->\r\n\r\n <section class=\"about_section layout_padding\">\r\n  <div class=\"container-fluid\">\r\n    <div class=\"row\">\r\n      <div class=\"col-md-10 ml-auto pr-0\">\r\n        <!-- เพิ่มการกำหนด background image ในกล่องนี้ -->\r\n        <div class=\"about_container\" style=\"padding: 45px; background-image: url('../images/about-bg.jpg'); background-size: 100%; background-repeat: no-repeat;\">\r\n          <div class=\"row\">\r\n            <div class=\"col-lg-3 col-md-5\">\r\n              <div class=\"detail-box\">\r\n                <div class=\"heading_container\">\r\n                  <h2>\r\n                    𝓗𝓸𝓵𝓵𝔂𝔀𝓸𝓸𝓭 𝓧 𝓞𝓶𝓮𝓰𝓪𝓿𝓮𝓻𝓼𝓮\r\n                  </h2>\r\n                </div>\r\n                <p>\r\n                  “ย่านแห่งหนึ่ง ตะวันตกเฉียงเหนือของตัวเมืองลอสแองเจลิส”<br />\r\n                  <br />\r\n                  “ขอต้อนรับสู่ย่านแห่งความฝัน ฮอลลีวูด อุตสาหกรรมภาพยนตร์ที่เก่าแก่ที่สุด”<br />\r\n                  <br />\r\n                  “แต่นั่นเป็นเพียงเปลือกนอก เมื่อภายในกองถ่ายนั้นคลุกกรุ่นไปด้วยสารเสพติด การกดขี่ เหยียดหยาม และการล่วงละเมิดทางเพศโดยเฉพาะกับโอเมก้าไร้ทางสู้”\r\n                </p>\r\n                <a href=\"\">\r\n                  Pin image\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</section>\r\n<!-- end about section -->\r\n\r\n<!-- end about section -->\r\n\r\n  \r\n    <!-- about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 45px; background-image: url('./images/Mid.jpg'); background-size: 100%; ; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <div class=\"heading_container\">\r\n                      <h2>\r\n                        Plot\r\n                      </h2>\r\n                    </div>\r\n                    <p>\r\n                      ในโลกที่อัลฟ่าเป็นใหญ่นั้นการมีชื่อเสียงไม่ใช่สิ่งที่ง่าย วงการฮอลลีวูดมีเรื่องราวมากกว่าเพียงแค่เงินตรา ชื่อเสียง การปรากฏตัวอย่างสง่างามบนพรมแดงพร้อมแสงสีของกล้องจอแก้วท่ามกลางแฟนคลับที่รักยิ่งหลายล้านคน ภายในกลับเต็มไปด้วยความเน่าเฟะ การล่วงละเมิดทางเพศ การใช้สารเสพติดเกินขนาด และการกดขี่โอเมก้า นี่คือความลับดํามืดที่น่าสยดสยองในวงการบันเทิง <br />\r\n                    </p>\r\n                    <hr />\r\n                    <a href=\"\">\r\n                      Send Form\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <!-- end about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 30px; background-image: url('../images/ing.jpg'); background-size: 100%; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <p>\r\n                      Theme: Hollywood | Actor | Actress | Activity | Drugs | Slow life | Violence | Drama | Toxic relationships | Omegaverse | 18+ <br />\r\n                      <br/>\r\n                      Type : Red[Violence | Drugs | Harsh words | Toxic relationships ] <br />\r\n                      <br/>\r\n                      Image : Celebrity[จำกัดเมจเอเชีย10คน][ไม่รับเมจรูปวาด อนิเมะ หรือจากเว็บสร้างใดๆ] <br />\r\n                      <br/>\r\n                      Location: Hollywood Hills | Los Angeles County | California<br />\r\n                      <br/>\r\n                      Timeline: Current<br />\r\n                      <br/>\r\n                      Active : 3 weeks<br />\r\n                      <br/>\r\n                      Platform: Instagram [#HH]<br />\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <!-- end about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 10px; background-image: url('../images/tete.jpg'); background-size: 100%; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <div class=\"heading_container\"></div>\r\n                      <h2>\r\n                        Rule\r\n                      </h2>\r\n                    </div>\r\n                    <p>\r\n                      1.)ไม่อนุมัติการลงอิมเมจอนิเมะหรือรูปวาด ต้องลงอิมเมจคนจริงเท่านั้น สามารถฟลิบเปลี่ยนเมจได้เพียง3ครั้ง<br />\r\n                      <br/>\r\n                      2.)จำกัดลงเมจเอเชีย8คน<br />\r\n                      <br/>\r\n                      3.)จูนิเบียวให้เหมาะสมกับคาร์แรคเตอร์ แกรี่หรือแมรี่ซูขอไม่รับ <br />\r\n                      <br/>\r\n                      4.)แม้ในความเป็นจริงในวงการฮอลลีวูดจะมีประเด็นคดีใคร่เด็กแต่ในส่วนนี้ทางเราขอตัดออกเพื่อเคารพเนื้อหาทางศีลธรรม ขึ้นอยู่กับดุลพินิจของผู้โรลและโปรดใช้วิจารณญาณว่าเหมาะสมหรือไม่<br />\r\n                      <br/>\r\n                      5.)สามารถเหยียดหรือล้อเลียนได้ตามคาร์แต่โปรดยังอยู่ในความเคารพคู่โรลควรมีการดีลกันมาก่อน<br />\r\n                      <br/>\r\n                      6.)ห้ามทะเลาะกันเอง พบเจอจะตักเตือนก่อน หากยังไม่เข้าใจกันสต๊าฟจะเข้ามาเคลียร์ให้เอง<br />\r\n                      <br/>\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <!-- end about section -->\r\n\r\n    <!-- about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 45px; background-image: url('./images/The.jpg'); background-size: 130%; ; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <div class=\"heading_container\">\r\n                      <h2>\r\n                        Position\r\n                      </h2>\r\n                    </div>\r\n                    <p>\r\n                      Actor | Actress | Model [นักแสดง นายแบบ นางแบบ] <br />\r\n                      <br />\r\n                      Director [ผู้กำกับ]<br />\r\n                      <br />\r\n                      Producer [โปรดิวเซอร์]<br />\r\n                      <br />\r\n                      Photography [ช่างภาพ]<br />\r\n                      <br />\r\n                      Scriptwriter [นักเขียนบท]<br />\r\n                      <br />\r\n                      Composer [นักแต่งเพลง]<br />\r\n                      <br />\r\n                      Costume Designer [นักออกแบบเครื่องแต่งกาย]<br />\r\n                      <br />\r\n                      Paparazzi [นักข่าวสายบันเทิงที่นำเสนอข่าวในแนวแอบถ่าย]<br />\r\n                      <br />\r\n                      Reporter | Journalist [นักข่าว]<br /> \r\n                      <br />\r\n                      More [โปรดระบุในขอบเขตกองถ่าย] \r\n                    </p>\r\n                    <a href=\"\">\r\n                      Form\r\n                    </a>\r\n                    <a href=\"\">\r\n                      Check\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <!-- end about section -->\r\n\r\n<section class=\"blog_section layout_padding\">\r\n  <div class=\"container-fluid\">\r\n    <div class=\"row\">\r\n      <div class=\"col-md-10 ml-auto\">\r\n        <div class=\"heading_container\">\r\n          <h2>\r\n            Omegaverse\r\n          </h2>\r\n          <p>\r\n            Omegaverse หรือ จักรวาล A/B/O เป็นจักรวาลสมมติที่ถูกสร้างต่อยอดมาจากแฟนฟิคซีรี่ส์ยอดนิยมจากฝั่งตะวันตกเรื่อง Supernatural กล่าวถึงความสัมพันธ์ลึกซึ้งระหว่างบุคคลที่อ้างอิงรายละเอียดต่างๆ มาจากการแบ่งชั้นชนทางสังคมของ \"ฝูงหมาป่า\" และประเภทย่อยของการตั้งครรภ์ของผู้ชายซึ่งผู้หญิงเองก็สามารถทำผู้ชายท้องได้เช่นกัน แรงบันดาลใจอีกแหล่งหนึ่งอาจเป็นละครนิยายวิทยาศาสตร์เรื่อง Dark Angel \r\n            <br />\r\n            <br />\r\n            สามารถลงนอกเหนือจากที่ยกตัวอย่างได้ นี่เป็นเพียงการให้รายละเอียดเบื้องต้นของจักรวาลเท่านั้น\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"row\">\r\n      <div class=\"col-md-6 pl-0\">\r\n        <div class=\"box b1\">\r\n          <div class=\"img-box\">\r\n            <img src=\"images/b1.jpg\" alt=\"\" >\r\n          </div>\r\n          <div class=\"row\">\r\n            <div class=\"col-lg-8 col-md-10 ml-auto\">\r\n              <div class=\"detail-box\">\r\n                <div class=\"img_date\">\r\n                  <h6>\r\n                    α\r\n                  </h6>\r\n                </div>\r\n                <h3>\r\n                  Alpha \r\n                </h3>\r\n                <p>\r\n                  อัลฟ่าเป็นลำดับสูงสุดในจักรวาลโอเมก้าเวิร์ส อัลฟ่ามีหลายสิ่งที่แยกพวกเขาออกจากประเภทอื่น ตั้งแต่ลักษณะทางกายภาพ คุณลักษณะทางจิตวิทยา และสรีรวิทยา\r\n                  สำหรับอัลฟ่าเพศเมีย พวกเขาไม่สามารถท้องได้แต่สามารถทำให้โอเมก้าท้องได้ อัลฟ่ามักจะมีกลิ่นฉุนแรง กลิ่นนี้สามารถทำให้โอเมก้าตกหลุมรักพวกเขาได้\r\n                   พวกเขาไม่สามารถต้านกลิ่นโอเมก้าบางคนที่เย้ายวนได้\r\n                </p>\r\n                <a href=\"https://www.wattpad.com/546924059-the-unofficial-guide-to-the-omegaverse-basic\">\r\n                  Read More\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"col-md-6 pr-0\">\r\n        <div class=\"box b2\">\r\n          <div class=\"img-box\">\r\n            <img src=\"images/b2.jpg\" alt=\"\">\r\n          </div>\r\n          <div class=\"row\">\r\n            <div class=\"col-lg-8 col-md-10 mr-auto\">\r\n              <div class=\"detail-box\">\r\n                <div class=\"img_date\">\r\n                  <h6>\r\n                    β\r\n                  </h6>\r\n                </div>\r\n                <h3>\r\n                  Beta\r\n                </h3>\r\n                <p>\r\n                  เบต้าเป็นมนุษย์ทั่วไปที่มีข้อยกเว้นบางประการ ประการหนึ่งคือพวกเขามีกลิ่นอ่อนมากเพราะต่อมของพวกเขาไม่ผลิตกลิ่นมากเท่ากับอัลฟ่าหรือโอเมก้า หากเป็นเพศชายจะไม่สามารถตั้งครรภ์จากอัลฟ่าได้ เบต้าเพศเมียก็เหมือนกับคนทั่วไปที่สามารถตั้งครรภ์ได้ เบต้าสามารถสืบพันธุ์ร่วมกับอัลฟ่าได้ แต่พวกเขาจะรู้สึกเจ็บปวดในระดับต่างกัน กลิ่นของพวกเขาทำให้โอเมก้าและอัลฟ่าสงบลงได้\r\n                </p>\r\n                <a href=\"https://www.wattpad.com/546924059-the-unofficial-guide-to-the-omegaverse-basic\">\r\n                  Read More\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"row\">\r\n    <div class=\"col-md-6 pl-0\">\r\n      <div class=\"box b1\">\r\n        <div class=\"img-box\">\r\n          <img src=\"images/b3.jpg\" alt=\"\" >\r\n        </div>\r\n        <div class=\"row\">\r\n          <div class=\"col-lg-8 col-md-10 ml-auto\">\r\n            <div class=\"detail-box\">\r\n              <div class=\"img_date\">\r\n                <h6>\r\n                  Ω\r\n                </h6>\r\n              </div>\r\n              <h3>\r\n                Omega\r\n              </h3>\r\n              <p>\r\n                โอเมก้าอยู่ลำดับต่ำสุดในจักรวาลโอเมก้าเวิร์ส โอเมก้าเพศเมียมีโครงสร้างร่างกายทั่วไปไม่จำเป็นต้องมีอะไรพิเศษหรือแปลกใหม่ในระหว่างกระบวนการคลอด ในทางกลับกันโอเมก้าเพศผู้มีอวัยวะสืบพันธุ์เหมือนกับเพศเมีย พวกเขามีกลิ่นที่ดึงดูดอัลฟ่าได้เช่นกัน ในช่วงเวลาหนึ่งพวกเขาจะปล่อยมันออกมามากทำให้ต้องติดแผ่นยับยั้ง บางครั้งอาจกระทบการงานพวกเขา\r\n              </p>\r\n              <a href=\"https://www.wattpad.com/546924059-the-unofficial-guide-to-the-omegaverse-basic\">\r\n                Read More\r\n              </a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"col-md-6 pr-0\">\r\n      <div class=\"box b2\">\r\n        <div class=\"img-box\">\r\n          <img src=\"images/b4.jpg\" alt=\"\" style=\"width: 800px; height:670px;\" >\r\n        </div>\r\n        <div class=\"row\">\r\n          <div class=\"col-lg-8 col-md-10 mr-auto\">\r\n            <div class=\"detail-box\">\r\n              <div class=\"img_date\">\r\n                <h6>\r\n                  δ\r\n                </h6>\r\n              </div>\r\n              <h3>\r\n                Delta\r\n              </h3>\r\n              <p>\r\n                เดลต้ามีลักษณะคล้ายกับอัลฟ่า แต่มีลักษณะทางพฤติกรรมเท่านั้นหรือก็คือพวกเขาก้าวร้าวและหวงอาณาเขต แต่เมื่ออยู่ร่วมกับอัลฟ่าแล้วพวกเขาจะอยู่ในลำดับที่สองของการเป็นผุ้นำและเป็นมือขวาของอัลฟ่า\r\n                โดยปกติแล้วจะมีเดลต้าหนึ่งคนในฝูง กลิ่นของพวกเขาไม่แรงเท่าอัลฟ่าแต่ก็ไม่อ่อนเท่าเบต้า และสามารถกระตุ้นโอเมก้าได้\r\n              </p>\r\n              <a href=\"https://www.wattpad.com/546924059-the-unofficial-guide-to-the-omegaverse-basic\">\r\n                Read More\r\n              </a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<div class=\"row\">\r\n  <div class=\"col-md-6 pl-0\">\r\n    <div class=\"box b1\">\r\n      <div class=\"img-box\">\r\n        <img src=\"images/b5.png\" alt=\"\" style=\"width: 800px; height:670px;\" >\r\n      </div>\r\n      <div class=\"row\">\r\n        <div class=\"col-lg-8 col-md-10 ml-auto\">\r\n          <div class=\"detail-box\">\r\n            <div class=\"img_date\">\r\n              <h6>\r\n                Γ\r\n              </h6>\r\n            </div>\r\n            <h3>\r\n              Gamma\r\n            </h3>\r\n            <p>\r\n              แกมม่าโดยพื้นฐานแล้วคือเบต้าที่มีลักษณะเฉพาะของโอเมก้า อย่างไรก็ตาม พวกเขาไม่สามารถรับกลิ่นของอัลฟ่า แกมมา และโอเมก้าได้ \r\n              เว้นแต่จะเป็นโอเมก้าในช่วงติดสัดหรืออัลฟ่าในช่วงติดสัด อย่างไรก็ตาม พวกเขาไม่เหมือนกับมนุษย์เนื่องจากพวกเขายังคงมีลักษณะหลายอย่างที่คล้ายกับโอเมก้า ซึ่งก็คือยอมจำนนต่อเบต้า เดลต้า และอัลฟ่า\r\n              ยกเว้นโอเมก้า พวกเขาเกี่ยวข้องกับโอเมก้า เนื่องจากมีสัญชาตญาณความเป็นแม่ที่แรงกล้าแม้ว่าจะเป็นเพศผู้หรือเพศเมียก็ตาม\r\n            </p>\r\n            <a href=\"https://www.wattpad.com/546924059-the-unofficial-guide-to-the-omegaverse-basic\">\r\n              Read More\r\n            </a>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"col-md-6 pr-0\">\r\n    <div class=\"box b2\">\r\n      <div class=\"img-box\">\r\n        <img src=\"images/b6.jpg\" alt=\"\" style=\"width: 800px; height:670px;\">\r\n      </div>\r\n      <div class=\"row\">\r\n        <div class=\"col-lg-8 col-md-10 mr-auto\">\r\n          <div class=\"detail-box\">\r\n            <div class=\"img_date\">\r\n              <h6>\r\n                E\r\n              </h6>\r\n            </div>\r\n            <h3>\r\n              Enigma\r\n            </h3>\r\n            <p>\r\n              เป็นเพศที่หายากที่สุด มีความแข็งแกร่ง สติปัญญาที่เหนือกว่าและไม่มีใครสามารถต้านทานเสน่ห์ของพวกเขาได้ โดยพื้นฐานแล้วพวกเขาเป็นเพศที่ดีที่สุด พวกเขามีพฤติกรรมคล้ายอัลฟ่า ก้าวร้าวและควบคุมหลาอย่างได้มากกว่าอัลฟ่าตัวจริงด้วยซ้ํา พวกเขาไม่ก้มหัวต่อใครและไม่ยอมจํานน พวกเขาสามารถบังคับบัญชาได้ทุกเพศรวมถึงอัลฟ่า \r\n              สามารถทําให้ทุกเพศตั้งครรภ์ได้ รวมถึงอัลฟ่าตัวเมียด้วย<br>\r\n              กลิ่นของพวกเขาไม่สามารถแทนที่โอเมก้าได้ แต่พวกเขาสามารถต้านทานฟีโรโมนของโอเมก้าได้ ซึ่งแตกต่างจากอัลฟ่าที่จะเข้าสู่ความต้องการหากพวกเขาได้กลิ่นฟีโรโมนของโอเมก้า\r\n            </p>\r\n            <a href=\"https://aminoapps.com/c/yaoiiomegaverse/page/item/enigmas/wMKQ_LeCpIW1637DKd6w0R44jxZ8dYD3qm\">\r\n              Read More\r\n            </a>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</div>\r\n\r\n</section>\r\n\r\n</section>\r\n\r\n <!-- info section -->\r\n<div class=\"info_section\">\r\n  <div class=\"container-fluid\">\r\n    <div class=\"row\">\r\n      <div class=\"col-md-10 ml-auto\">\r\n        <div class=\"row info_main-row\">\r\n          <div class=\"col-md-6 pr-0\">\r\n\r\n            <!-- footer section -->\r\n            <section class=\"footer_section\">\r\n              <div class=\"social_box\">\r\n                <a href=\"https://www.facebook.com/profile.php?id=100014243778331\">\r\n                  <img src=\"images/facebook.png\" alt=\"\">\r\n                  <span>Königin Der Herzen</span>\r\n                </a>\r\n                <a href=\"https://www.facebook.com/profile.php?id=100095368592925\">\r\n                  <img src=\"images/facebook.png\" alt=\"\">\r\n                  <span>Trey S. Hardrock</span>\r\n                </a>\r\n                <a href=\"https://www.facebook.com/profile.php?id=100079927197640\">\r\n                  <img src=\"images/facebook.png\" alt=\"\">\r\n                  <span>Theodoric T. Torres</span>\r\n                </a>\r\n                <a href=\"https://www.facebook.com/profile.php?id=100074561253444\">\r\n                  <img src=\"images/facebook.png\" alt=\"\">\r\n                  <span>Kawinthip Doungpakote</span>\r\n                </a>\r\n                <a href=\"https://www.facebook.com/midfield.alvarez\">\r\n                  <img src=\"images/facebook.png\" alt=\"\">\r\n                  <span>MID FIELD</span>\r\n                </a>\r\n                <a href=\"https://www.facebook.com/profile.php?id=100075234154325\">\r\n                  <img src=\"images/facebook.png\" alt=\"\">\r\n                  <span>อี' แต๋ว</span>\r\n                </a>\r\n              </div>\r\n            </section>\r\n            <!-- footer section -->\r\n\r\n          </div>\r\n          <div class=\"col-md-6  px-0\">\r\n            <div class=\"img-box\">\r\n              <img src=\"images/footer-img.jpg\" alt=\"\">\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n<!-- end info section -->\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n <script type=\"text/javascript\" src=\"js/jquery-3.4.1.min.js\"></script>\r\n <script type=\"text/javascript\" src=\"js/bootstrap.js\"></script>\r\n <script type=\"text/javascript\" src=\"https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js\">\r\n </script>\r\n\r\n <script>\r\n   function openNav() {\r\n     document.getElementById(\"myNav\").classList.toggle(\"menu_width\");\r\n     document.querySelector(\".custom_menu-btn\").classList.toggle(\"menu_btn-style\");\r\n   }\r\n </script>\r\n\r\n <!-- owl carousel script -->\r\n <script type=\"text/javascript\">\r\n   $(\".owl-carousel\").owlCarousel({\r\n     loop: true,\r\n     margin: 10,\r\n     nav: true,\r\n     navText: [],\r\n     autoplay: true,\r\n     autoplayHoverPause: true,\r\n     responsive: {\r\n       0: {\r\n         items: 1\r\n       },\r\n       600: {\r\n         items: 2\r\n       },\r\n       1000: {\r\n         items: 2\r\n       }\r\n     }\r\n   });\r\n\r\n\r\n   $(\".owl_carousel1\").owlCarousel({\r\n     loop: true,\r\n     margin: 25,\r\n     nav: true,\r\n     navText: [],\r\n     autoplay