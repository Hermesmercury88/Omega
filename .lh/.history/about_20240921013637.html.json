            "content": "<!DOCTYPE html>\r\n<html>\r\n\r\n<head>\r\n  <!-- Basic -->\r\n  <meta charset=\"utf-8\" />\r\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\r\n  <!-- Mobile Metas -->\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\" />\r\n  <!-- Site Metas -->\r\n  <meta name=\"keywords\" content=\"\" />\r\n  <meta name=\"description\" content=\"\" />\r\n  <meta name=\"author\" content=\"\" />\r\n\r\n  <title>Hollywood</title>\r\n\r\n  <!-- favicon -->\r\n  <link rel=\"icon\" type=\"image/x-icon\" href=\"images/logo.png\" />\r\n\r\n  <!-- slider stylesheet -->\r\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css\" />\r\n\r\n  <!-- bootstrap core css -->\r\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"css/bootstrap.css\" />\r\n\r\n  <!-- fonts style -->\r\n  <link href=\"https://fonts.googleapis.com/css?family=Baloo+Chettan|Dosis:400,600,700|Poppins:400,600,700&display=swap\" rel=\"stylesheet\" />\r\n  <!-- Custom styles for this template -->\r\n  <link href=\"css/style.css\" rel=\"stylesheet\" />\r\n  <!-- responsive style -->\r\n  <link href=\"css/responsive.css\" rel=\"stylesheet\" />>\r\n</head>\r\n\r\n<body class=\"sub_page\">\r\n  <div class=\"hero_area\">\r\n    <!-- header section strats -->\r\n    <header class=\"header_section\">\r\n      <div class=\"container\">\r\n        <div class=\"header_nav\">\r\n          <a class=\"navbar-brand brand_desktop\" href=\"index.html\">\r\n            <img src=\"images/logo.png\" alt=\"\" />\r\n          </a>\r\n          <div class=\"main_nav\">\r\n            \r\n            \r\n            <div class=\"bottom_nav\">\r\n              <nav class=\"navbar navbar-expand-lg custom_nav-container\">\r\n                <a class=\"navbar-brand brand_mobile\" href=\"index.html\">\r\n                  <img src=\"images/logo.png\" alt=\"\" />\r\n                </a>\r\n                <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\r\n                  <span class=\"navbar-toggler-icon\"></span>\r\n                </button>\r\n                <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\r\n                  <div class=\"d-flex ml-auto flex-column flex-lg-row align-items-center\">\r\n                    <ul class=\"navbar-nav  \">\r\n                      <li class=\"nav-item active\">\r\n                        <a class=\"nav-link\" href=\"index.html\">Home <span class=\"sr-only\">(current)</span></a>\r\n                      </li>\r\n                      <li class=\"nav-item\">\r\n                        <a class=\"nav-link\" href=\"about.html\"> About </a>\r\n                      </li>\r\n                      <li class=\"nav-item\">\r\n                        <a class=\"nav-link\" href=\"information.html\"> information </a>\r\n                      </li>\r\n                      <li class=\"nav-item\">\r\n                        <a class=\"nav-link\" href=\"personnel.html\">Personnel</a>\r\n                      </li>\r\n                    </ul>\r\n                    <form class=\"form-inline\">\r\n                      <button class=\"btn ml-3 ml-lg-5 nav_search-btn\" type=\"submit\"></button>\r\n                    </form>\r\n                  </div>\r\n                </div>\r\n              </nav>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </header>\r\n    <!-- end header section -->\r\n  </div>\r\n\r\n <!-- about section -->\r\n\r\n <section class=\"about_section layout_padding\">\r\n  <div class=\"container-fluid\">\r\n    <div class=\"row\">\r\n      <div class=\"col-md-10 ml-auto pr-0\">\r\n        <!-- เพิ่มการกำหนด background image ในกล่องนี้ -->\r\n        <div class=\"about_container\" style=\"padding: 45px; background-image: url('../images/about-bg.jpg'); background-size: 100%; background-repeat: no-repeat;\">\r\n          <div class=\"row\">\r\n            <div class=\"col-lg-3 col-md-5\">\r\n              <div class=\"detail-box\">\r\n                <div class=\"heading_container\">\r\n                  <h2>\r\n                    𝓗𝓸𝓵𝓵𝔂𝔀𝓸𝓸𝓭 𝓧 𝓞𝓶𝓮𝓰𝓪𝓿𝓮𝓻𝓼𝓮\r\n                  </h2>\r\n                </div>\r\n                <p>\r\n                  “ย่านแห่งหนึ่ง ตะวันตกเฉียงเหนือของตัวเมืองลอสแองเจลิส”<br />\r\n                  <br />\r\n                  “ขอต้อนรับสู่ย่านแห่งความฝัน ฮอลลีวูด อุตสาหกรรมภาพยนตร์ที่เก่าแก่ที่สุด”<br />\r\n                  <br />\r\n                  “แต่นั่นเป็นเพียงเปลือกนอก เมื่อภายในกองถ่ายนั้นคลุกกรุ่นไปด้วยสารเสพติด การกดขี่ เหยียดหยาม และการล่วงละเมิดทางเพศโดยเฉพาะกับโอเมก้าไร้ทางสู้”\r\n                </p>\r\n                <a href=\"\">\r\n                  Pin image\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</section>\r\n<!-- end about section -->\r\n\r\n<!-- end about section -->\r\n\r\n  \r\n    <!-- about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 45px; background-image: url('./images/Mid.jpg'); background-size: 100%; ; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <div class=\"heading_container\">\r\n                      <h2>\r\n                        Plot\r\n                      </h2>\r\n                    </div>\r\n                    <p>\r\n                      ในโลกที่อัลฟ่าเป็นใหญ่นั้นการมีชื่อเสียงไม่ใช่สิ่งที่ง่าย วงการฮอลลีวูดมีเรื่องราวมากกว่าเพียงแค่เงินตรา ชื่อเสียง การปรากฏตัวอย่างสง่างามบนพรมแดงพร้อมแสงสีของกล้องจอแก้วท่ามกลางแฟนคลับที่รักยิ่งหลายล้านคน ภายในกลับเต็มไปด้วยความเน่าเฟะ การล่วงละเมิดทางเพศ การใช้สารเสพติดเกินขนาด และการกดขี่โอเมก้า นี่คือความลับดํามืดที่น่าสยดสยองในวงการบันเทิง <br />\r\n                    </p>\r\n                    <hr />\r\n                    <a href=\"\">\r\n                      Send Form\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <!-- end about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 30px; background-image: url('../images/ing.jpg'); background-size: 100%; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <p>\r\n                      Theme: Hollywood | Actor | Actress | Activity | Drugs | Slow life | Violence | Drama | Toxic relationships | Omegaverse | 18+ <br />\r\n                      <br/>\r\n                      Type : Red[Violence | Drugs | Harsh words | Toxic relationships ] <br />\r\n                      <br/>\r\n                      Image : Celebrity[จำกัดเมจเอเชีย10คน][ไม่รับเมจรูปวาด อนิเมะ หรือจากเว็บสร้างใดๆ] <br />\r\n                      <br/>\r\n                      Location: Hollywood Hills | Los Angeles County | California<br />\r\n                      <br/>\r\n                      Timeline: Current<br />\r\n                      <br/>\r\n                      Active : 3 weeks<br />\r\n                      <br/>\r\n                      Platform: Instagram [#HH]<br />\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <!-- end about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 10px; background-image: url('../images/tete.jpg'); background-size: 100%; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <div class=\"heading_container\"></div>\r\n                      <h2>\r\n                        Rule\r\n                      </h2>\r\n                    </div>\r\n                    <p>\r\n                      1.)ไม่อนุมัติการลงอิมเมจอนิเมะหรือรูปวาด ต้องลงอิมเมจคนจริงเท่านั้น สามารถฟลิบเปลี่ยนเมจได้เพียง3ครั้ง<br />\r\n                      <br/>\r\n                      2.)จำกัดลงเมจเอเชีย8คน<br />\r\n                      <br/>\r\n                      3.)จูนิเบียวให้เหมาะสมกับคาร์แรคเตอร์ แกรี่หรือแมรี่ซูขอไม่รับ <br />\r\n                      <br/>\r\n                      4.)แม้ในความเป็นจริงในวงการฮอลลีวูดจะมีประเด็นคดีใคร่เด็กแต่ในส่วนนี้ทางเราขอตัดออกเพื่อเคารพเนื้อหาทางศีลธรรม ขึ้นอยู่กับดุลพินิจของผู้โรลและโปรดใช้วิจารณญาณว่าเหมาะสมหรือไม่<br />\r\n                      <br/>\r\n                      5.)สามารถเหยียดหรือล้อเลียนได้ตามคาร์แต่โปรดยังอยู่ในความเคารพคู่โรลควรมีการดีลกันมาก่อน<br />\r\n                      <br/>\r\n                      6.)ห้ามทะเลาะกันเอง พบเจอจะตักเตือนก่อน หากยังไม่เข้าใจกันสต๊าฟจะเข้ามาเคลียร์ให้เอง<br />\r\n                      <br/>\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <!-- end about section -->\r\n\r\n    <!-- about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 45px; background-image: url('./images/The.jpg'); background-size: 130%; ; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <div class=\"heading_container\">\r\n                      <h2>\r\n                        Position\r\n                      </h2>\r\n                    </div>\r\n                    <p>\r\n                      Actor | Actress | Model [นักแสดง นายแบบ นางแบบ] <br />\r\n                      <br />\r\n                      Director [ผู้กำกับ]<br />\r\n                      <br />\r\n                      Producer [โปรดิวเซอร์]<br />\r\n                      <br />\r\n                      Photography [ช่างภาพ]<br />\r\n                      <br />\r\n                      Scriptwriter [นักเขียนบท]<br />\r\n                      <br />\r\n                      Composer [นักแต่งเพลง]<br />\r\n                      <br />\r\n                      Costume Designer [นักออกแบบเครื่องแต่งกาย]<br />\r\n                      <br />\r\n                      Paparazzi [นักข่าวสายบันเทิงที่นำเสนอข่าวในแนวแอบถ่าย]<br />\r\n                      <br />\r\n                      Reporter | Journalist [นักข่าว]<br /> \r\n                      <br />\r\n                      More [โปรดระบุในขอบเขตกองถ่าย] \r\n                    </p>\r\n                    <a href=\"\">\r\n                      Form\r\n                    </a>\r\n                    <a href=\"\">\r\n                      Check\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n   