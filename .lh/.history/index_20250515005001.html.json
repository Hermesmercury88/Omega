            "content": "<!DOCTYPE html>\r\n<html>\r\n\r\n<head>\r\n  <!-- Basic -->\r\n  <meta charset=\"utf-8\" />\r\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\r\n  <!-- Mobile Metas -->\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\" />\r\n  <!-- Site Metas -->\r\n  <meta name=\"keywords\" content=\"\" />\r\n  <meta name=\"description\" content=\"\" />\r\n  <meta name=\"author\" content=\"\" />\r\n\r\n  <title>Hollywood</title>\r\n\r\n  <!-- favicon -->\r\n  <link rel=\"icon\" type=\"image/x-icon\" href=\"images/logo.png\" />\r\n\r\n  <!-- slider stylesheet -->\r\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css\" />\r\n\r\n  <!-- bootstrap core css -->\r\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"css/bootstrap.css\" />\r\n\r\n  <!-- fonts style -->\r\n  <link href=\"https://fonts.googleapis.com/css?family=Baloo+Chettan|Dosis:400,600,700|Poppins:400,600,700&display=swap\" rel=\"stylesheet\" />\r\n  <!-- Custom styles for this template -->\r\n  <link href=\"css/style.css\" rel=\"stylesheet\" />\r\n  <!-- responsive style -->\r\n  <link href=\"css/responsive.css\" rel=\"stylesheet\" />\r\n</head>\r\n\r\n\r\n<body>\r\n  <div class=\"hero_area\">\r\n    <!-- header section strats -->\r\n    <header class=\"header_section\">\r\n      <div class=\"container\">\r\n        <div class=\"header_nav\">\r\n          <a class=\"navbar-brand brand_desktop\" href=\"index.html\">\r\n            <img src=\"images/logo.png\" alt=\"\" />\r\n          </a>\r\n          <div class=\"main_nav\">\r\n            \r\n            <div class=\"bottom_nav\">\r\n              <nav class=\"navbar navbar-expand-lg custom_nav-container\">\r\n                <a class=\"navbar-brand brand_mobile\" href=\"index.html\">\r\n                  <img src=\"images/logo.png\" alt=\"\" />\r\n                </a>\r\n                <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\r\n                  <span class=\"navbar-toggler-icon\"></span>\r\n                </button>\r\n                <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\r\n                  <div class=\"d-flex ml-auto flex-column flex-lg-row align-items-center\">\r\n                    <ul class=\"navbar-nav  \">\r\n                      <li class=\"nav-item active\">\r\n                        <a class=\"nav-link\" href=\"index.html\">Home <span class=\"sr-only\">(current)</span></a>\r\n                      </li>\r\n                      <li class=\"nav-item\">\r\n                        <a class=\"nav-link\" href=\"key.html\"> About </a>\r\n                      </li>\r\n                      <li class=\"nav-item\">\r\n                        <a class=\"nav-link\" href=\"information.html\"> information </a>\r\n                      </li>\r\n                      <li class=\"nav-item\">\r\n                        <a class=\"nav-link\" href=\"personnel.html\">Personnel</a>\r\n                      </li>\r\n                    </ul>\r\n                  </div>\r\n                </div>\r\n              </nav>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </header>\r\n    <!-- end header section -->\r\n <!-- slider section -->\r\n <section class=\"slider_section position-relative\">\r\n  <div class=\"container-fluid\">\r\n    <div class=\"row\">\r\n      <div class=\"col-md-2 offset-md-2\">\r\n        <div class=\"slider_heading\">\r\n          <h2>\r\n            #HH\r\n          </h2>\r\n        </div>\r\n      </div>\r\n      <div class=\"col-md-8 mx-auto\">\r\n        <div id=\"carouselExampleIndicators\" class=\"carousel slide\" data-ride=\"carousel\">\r\n          <ol class=\"carousel-indicators\">\r\n            <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"0\" class=\"active\">01</li>\r\n            <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"1\">02</li>\r\n            <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"2\">03</li>\r\n            <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"3\">04</li>\r\n          </ol>\r\n          <div class=\"carousel-inner\">\r\n            <div class=\"carousel-item active\">\r\n              <div class=\"box\">\r\n                <div class=\"detail-box\">\r\n                  <h1>\r\n                    ปักอิมเมจที่ตรงนี้\r\n                  </h1>\r\n                  <hr />\r\n                  <div class=\"btn-box\">\r\n                    <a href=\"https://docs.google.com/forms/d/e/1FAIpQLSfAyI88gt2T8e67WhwWKWujakO3OhahCqqUliEP9rtOJfaqFg/viewform\" target=\"_blank\" class=\"btn-1\">\r\n                      Pin image\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div class=\"carousel-item\">\r\n              <div class=\"box\">\r\n                <div class=\"detail-box\">\r\n                  <h1>\r\n                    ส่งฟอร์มที่ตรงนี้\r\n                  </h1>\r\n                  <hr />\r\n                  <div class=\"btn-box\">\r\n                    <a href=\"https://docs.google.com/forms/d/e/1FAIpQLScLy1qjL_sSlIciHIOmXNrHNK7Yerv2pxKg40W07d17ZFWPnw/viewform\" target=\"_blank\" class=\"btn-1\">\r\n                      Send Form\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div class=\"carousel-item\">\r\n              <div class=\"box\">\r\n                <div class=\"detail-box\">\r\n                  <h1>\r\n                    เช็คการส่งฟอร์มและเช็คอิมเมจที่ตรงนี้\r\n                  </h1>\r\n                  <hr />\r\n                  <div class=\"btn-box\">\r\n                    <a href=\"https://docs.google.com/spreadsheets/d/1MZAxfpDr6kdUjA_pU9oXcNLxDgg2OzjOoQ2xviGaQdY/edit?usp=sharing\" target=\"_blank\" class=\"btn-1\">\r\n                      Check\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div class=\"carousel-item\">\r\n              <div class=\"box\">\r\n                <div class=\"detail-box\">\r\n                  <h1>\r\n                    รับฟอร์มที่ตรงนี้\r\n                  </h1>\r\n                  <hr />\r\n                  <div class=\"btn-box\">\r\n                    <a href=\"https://docs.google.com/document/d/1FSIeONyXyG-PIBwWldAytgosCPqT1boFnBxVgS7nEHw/edit?usp=sharing\" target=\"_blank\" class=\"btn-1\">\r\n                      Form\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <a class=\"carousel-control-prev\" href=\"#carouselExampleIndicators\" role=\"button\" data-slide=\"prev\">\r\n            <span class=\"carousel-control-prev-icon\" aria-hidden=\"true\"></span>\r\n            <span class=\"sr-only\">Previous</span>\r\n          </a>\r\n          <a class=\"carousel-control-next\" href=\"#carouselExampleIndicators\" role=\"button\" data-slide=\"next\">\r\n            <span class=\"carousel-control-next-icon\" aria-hidden=\"true\"></span>\r\n            <span class=\"sr-only\">Next</span>\r\n          </a>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</section>    \r\n<!-- end slider section -->\r\n</div>\r\n\r\n   <!-- about section -->\r\n\r\n   <section class=\"about_section layout_padding\">\r\n    <div class=\"container-fluid\">\r\n      <div class=\"row\">\r\n        <div class=\"col-md-10 ml-auto pr-0\">\r\n          <!-- เพิ่มการกำหนด background image ในกล่องนี้ -->\r\n          <div class=\"about_container\" style=\"padding: 45px; background-image: url('./images/about-bg.jpg'); background-size: 100%; background-repeat: no-repeat;\">\r\n            <div class=\"row\">\r\n              <div class=\"col-lg-3 col-md-5\">\r\n                <div class=\"detail-box\">\r\n                  <div class=\"heading_container\">\r\n                    <h2>\r\n                      𝓗𝓸𝓵𝓵𝔂𝔀𝓸𝓸𝓭 𝓧 𝓞𝓶𝓮𝓰𝓪𝓿𝓮𝓻𝓼𝓮\r\n                    </h2>\r\n                  </div>\r\n                  <p>\r\n                    “ย่านแห่งหนึ่ง ตะวันตกเฉียงเหนือของตัวเมืองลอสแองเจลิส”<br />\r\n                    <br />\r\n                    “ขอต้อนรับสู่ย่านแห่งความฝัน ฮอลลีวูด อุตสาหกรรมภาพยนตร์ที่เก่าแก่ที่สุด”<br />\r\n                    <br />\r\n                    “แต่นั่นเป็นเพียงเปลือกนอก เมื่อภายในกองถ่ายนั้นคลุกกรุ่นไปด้วยสารเสพติด การกดขี่ เหยียดหยาม และการล่วงละเมิดทางเพศโดยเฉพาะกับโอเมก้าไร้ทางสู้”\r\n                  </p>\r\n                  <a href=\"https://docs.google.com/forms/d/e/1FAIpQLSfAyI88gt2T8e67WhwWKWujakO3OhahCqqUliEP9rtOJfaqFg/viewform\" target=\"_blank\" >\r\n                    Pin image\r\n                  </a>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n  \r\n  <!-- end about section -->\r\n\r\n  \r\n    <!-- about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 45px; background-image: url('./images/Mid.jpg'); background-size: 100%; ; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <div class=\"heading_container\">\r\n                      <h2>\r\n                        Plot\r\n                      </h2>\r\n                    </div>\r\n                    <p>\r\n                      ในโลกที่อัลฟ่าเป็นใหญ่นั้นการมีชื่อเสียงไม่ใช่สิ่งที่ง่าย วงการฮอลลีวูดมีเรื่องราวมากกว่าเพียงแค่เงินตรา ชื่อเสียง การปรากฏตัวอย่างสง่างามบนพรมแดงพร้อมแสงสีของกล้องจอแก้วท่ามกลางแฟนคลับที่รักยิ่งหลายล้านคน ภายในกลับเต็มไปด้วยความเน่าเฟะ การล่วงละเมิดทางเพศ การใช้สารเสพติดเกินขนาด และการกดขี่โอเมก้า นี่คือความลับดํามืดที่น่าสยดสยองในวงการบันเทิง <br />\r\n                    </p>\r\n                    <hr />\r\n                    <a href=\"https://docs.google.com/forms/d/e/1FAIpQLScLy1qjL_sSlIciHIOmXNrHNK7Yerv2pxKg40W07d17ZFWPnw/viewform\">\r\n                      Send Form\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <!-- end about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 30px; background-image: url('./images/ing.jpg'); background-size: 100%; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <p>\r\n                      Theme: Hollywood | Actor | Actress | Activity | Drugs | Slow life | Violence | Drama | Toxic relationships | Omegaverse | 18+ <br />\r\n                      <br/>\r\n                      Type : Red[Violence | Drugs | Harsh words | Toxic relationships ] <br />\r\n                      <br/>\r\n                      Image : Celebrity[จำกัดเมจเอเชีย10คน][ไม่รับเมจรูปวาด อนิเมะ หรือจากเว็บสร้างใดๆ] <br />\r\n                      <br/>\r\n                      Location: Hollywood Hills | Los Angeles County | California<br />\r\n                      <br/>\r\n                      Timeline: Current<br />\r\n                      <br/>\r\n                      Active : 3 weeks [หรือจนกว่าจะเลิกแอคทีฟ]<br />\r\n                      <br/>\r\n                      Platform: Instagram [#HH]<br />\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <!-- end about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 10px; background-image: url('./images/tete.jpg'); background-size: 120%; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <div class=\"heading_container\"></div>\r\n                      <h2>\r\n                        Rule\r\n                      </h2>\r\n                    </div>\r\n                    <p>\r\n                      1.)ไม่อนุมัติการลงอิมเมจอนิเมะหรือรูปวาด ต้องลงอิมเมจคนจริงเท่านั้น สามารถฟลิบเปลี่ยนเมจได้เพียง3ครั้ง<br />\r\n                      <br/>\r\n                      2.)จำกัดลงเมจเอเชีย8คน<br />\r\n                      <br/>\r\n                      3.)จูนิเบียวให้เหมาะสมกับคาร์แรคเตอร์ แกรี่หรือแมรี่ซูขอไม่รับ <br />\r\n                      <br/>\r\n                      4.)แม้ในความเป็นจริงในวงการฮอลลีวูดจะมีประเด็นคดีใคร่เด็กแต่ในส่วนนี้ทางเราขอตัดออกเพื่อเคารพเนื้อหาทางศีลธรรม ขึ้นอยู่กับดุลพินิจของผู้โรลและโปรดใช้วิจารณญาณว่าเหมาะสมหรือไม่<br />\r\n                      <br/>\r\n                      5.)สามารถหยาบคายเหยียดหรือล้อเลียนได้ตามคาร์แต่โปรดยังอยู่ในความเคารพคู่โรลควรมีการดีลกันมาก่อน<br />\r\n                      <br/>\r\n                      6.)ห้ามทะเลาะกันเอง พบเจอจะตักเตือนก่อน หากยังไม่เข้าใจกันสต๊าฟจะเข้ามาเคลียร์ให้เอง<br />\r\n                      <br/>\r\n                      7.)เรื่องบนเตียงขอให้ไปเล่นกันในส่วนตัว หน้าไมค์จะเกี่ยวกับงานในกองถ่าย ความรุนแรงของการใช้คำพูดและพฤติกรรม อย่าลืมตกลงกันระหว่างคู่โรลไว้ด้วย\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <!-- end about section -->\r\n\r\n    <!-- about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 45px; background-image: url('./images/The.jpg'); background-size: 130%; ; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <div class=\"heading_container\">\r\n                      <h2>\r\n                        Position\r\n                      </h2>\r\n                    </div>\r\n                    <p>\r\n                      Actor | Actress | Model [นักแสดง นายแบบ นางแบบ] <br />\r\n                      <br />\r\n                      Director [ผู้กำกับ]<br />\r\n                      <br />\r\n                      Producer [โปรดิวเซอร์]<br />\r\n                      <br />\r\n                      Photography [ช่างภาพ]<br />\r\n                      <br />\r\n                      Scriptwriter [นักเขียนบท]<br />\r\n                      <br />\r\n                      Composer [นักแต่งเพลง]<br />\r\n                      <br />\r\n                      Costume Designer [นักออกแบบเครื่องแต่งกาย]<br />\r\n                      <br />\r\n                      Paparazzi [นักข่าวสายบันเทิงที่นำเสนอข่าวในแนวแอบถ่าย]<br />\r\n                      <br />\r\n                      Reporter | Journalist [นักข่าว]<br /> \r\n                      <br />\r\n                      More [โปรดระบุในขอบเขตกองถ่าย] \r\n                    </p>\r\n                    <a href=\"https://docs.google.com/document/d/1FSIeONyXyG-PIBwWldAytgosCPqT1boFnBxVgS7nEHw/edit?usp=sharing\">\r\n                      Form\r\n                    </a>\r\n                    <a href=\"https://docs.google.com/spreadsheets/d/1MZAxfpDr6kdUjA_pU9oXcNLxDgg2OzjOoQ2xviGaQdY/edit?usp=sharing\">\r\n                      Check\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <!-- end about section -->\r\n\r\n    <!-- about section -->\r\n\r\n    <section class=\"about_section layout_padding\">\r\n      <div class=\"container-fluid\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-10 ml-auto pr-0\">\r\n            <div class=\"about_container\" style=\"padding: 45px; background-image: url('./images/fah.jpg'); background-size: 100%; ; background-repeat: no-repeat;\">\r\n              <div class=\"row\">\r\n                <div class=\"col-lg-3 col-md-5\">\r\n                  <div class=\"detail-box\">\r\n                    <div class=\"heading_container\">\r\n                      <h2>\r\n                        Official Instagram\r\n                      </h2>\r\n                    </div>\r\n                    <p>\r\n                      นี่เป็นบัญชีทางการของกลุ่มโรล สามารถฟอลแล้วแนบลิ้งค์ไอจีของตนเองที่คอมเม้นท์<br /> \r\n                      <br />\r\n                      อย่าลืมติด #HH ที่ไอจีตนเอง หากมีข้อสงสัยสามารถแจ้งสต๊าฟที่ช่องทางข้างล่างได้\r\n                    </p>\r\n                    <hr />\r\n                    <a href=\"https://www.instagram.com/hollywoodxomegaverse/?hl=en\">\r\n                      Official Instagram [#HH]\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <!-- end about section -->\r\n\r\n    <h2 class=\"map-heading\">Map</h2>\r\n    <div class=\"map-container\">\r\n    <img src=\"https://i2.wp.com/www.printablemapoftheunitedstates.net/wp-content/uploads/2021/04/disney-hollywood-studios-map-clicking-on-the-pic-will.jpg\" alt=\"Map of Disney Hollywood Studios\">\r\n    </div>\r\n    <br />\r\n    <br />\r\n\r\n  <!-- blog section -->\r\n\r\n  <section class=\"blog_section layout_padding\">\r\n    <div class=\"container-fluid\">\r\n      <div class=\"row\">\r\n        <div class=\"col-md-10 ml-auto\">\r\n          <div class=\"heading_container\">\r\n            <h2>\r\n              Omegaverse\r\n            </h2>\r\n            <p>\r\n              Omegaverse หรือ จักรวาล A/B/O เป็นจักรวาลสมมติที่ถูกสร้างต่อยอดมาจากแฟนฟิคซีรี่ส์ยอดนิยมจากฝั่งตะวันตกเรื่อง Supernatural กล่าวถึงความสัมพันธ์ลึกซึ้งระหว่างบุคคลที่อ้างอิงรายละเอียดต่างๆ มาจากการแบ่งชั้นชนทางสังคมของ \"ฝูงหมาป่า\" และประเภทย่อยของการตั้งครรภ์ของผู้ชายซึ่งผู้หญิงเองก็สามารถทำผู้ชายท้องได้เช่นกัน แรงบันดาลใจอีกแหล่งหนึ่งอาจเป็นละครนิยายวิทยาศาสตร์เรื่อง Dark Angel \r\n              <br />\r\n              <br />\r\n              สามารถลงนอกเหนือจากที่ยกตัวอย่างได้ นี่เป็นเพียงการให้รายละเอียดเบื้องต้นของจักรวาลเท่านั้น\r\n            </p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"row\">\r\n        <div class=\"col-md-6 pl-0\">\r\n          <div class=\"box b1\">\r\n            <div class=\"img-box\">\r\n              <img src=\"images/b1.jpg\" alt=\"\" >\r\n            </div>\r\n            <div class=\"row\">\r\n              <div class=\"col-lg-8 col-md-10 ml-auto\">\r\n                <div class=\"detail-box\">\r\n                  <div class=\"img_date\">\r\n                    <h6>\r\n                      α\r\n                    </h6>\r\n                  </div>\r\n                  <h3>\r\n                    Alpha \r\n                  </h3>\r\n                  <p>\r\n                    อัลฟ่าเป็นลำดับสูงสุดในจักรวาลโอเมก้าเวิร์ส อัลฟ่ามีหลายสิ่งที่แยกพวกเขาออกจากประเภทอื่น ตั้งแต่ลักษณะทางกายภาพ คุณลักษณะทางจิตวิทยา และสรีรวิทยา\r\n                    สำหรับอัลฟ่าเพศเมีย พวกเขาไม่สามารถท้องได้แต่สามารถทำให้โอเมก้าท้องได้ อัลฟ่ามักจะมีกลิ่นฉุนแรง กลิ่นนี้สามารถทำให้โอเมก้าตกหลุมรักพวกเขาได้\r\n                     พวกเขาไม่สามารถต้านกลิ่นโอเมก้าบางคนที่เย้ายวนได้\r\n                  </p>\r\n                  <a href=\"https://www.wattpad.com/546924059-the-unofficial-guide-to-the-omegaverse-basic\">\r\n                    Read More\r\n                  </a>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"col-md-6 pr-0\">\r\n          <div class=\"box b2\">\r\n            <div class=\"img-box\">\r\n              <img src=\"images/b2.jpg\" alt=\"\">\r\n            </div>\r\n            <div class=\"row\">\r\n              <div class=\"col-lg-8 col-md-10 mr-auto\">\r\n                <div class=\"detail-box\">\r\n                  <div class=\"img_date\">\r\n                    <h6>\r\n                      β\r\n                    </h6>\r\n                  </div>\r\n                  <h3>\r\n                    Beta\r\n                  </h3>\r\n                  <p>\r\n                    เบต้าเป็นมนุษย์ทั่วไปที่มีข้อยกเว้นบางประการ ประการหนึ่งคือพวกเขามีกลิ่นอ่อนมากเพราะต่อมของพวกเขาไม่ผลิตกลิ่นมากเท่ากับอัลฟ่าหรือโอเมก้า หากเป็นเพศชายจะไม่สามารถตั้งครรภ์จากอัลฟ่าได้ เบต้าเพศเมียก็เหมือนกับคนทั่วไปที่สามารถตั้งครรภ์ได้ เบต้าสามารถสืบพันธุ์ร่วมกับอัลฟ่าได้ แต่พวกเขาจะรู้สึกเจ็บปวดในระดับต่างกัน กลิ่นของพวกเขาทำให้โอเมก้าและอัลฟ่าสงบลงได้\r\n                  </p>\r\n                  <a href=\"https://www.wattpad.com/546924059-the-unofficial-guide-to-the-omegaverse-basic\">\r\n                    Read More\r\n                  </a>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"row\">\r\n      <div class=\"col-md-6 pl-0\">\r\n        <div class=\"box b1\">\r\n          <div class=\"img-box\">\r\n            <img src=\"images/b3.jpg\" alt=\"\" >\r\n          </div>\r\n          <div class=\"row\">\r\n            <div class=\"col-lg-8 col-md-10 ml-auto\">\r\n              <div class=\"detail-box\">\r\n                <div class=\"img_date\">\r\n                  <h6>\r\n                    Ω\r\n                  </h6>\r\n                </div>\r\n                <h3>\r\n                  Omega\r\n                </h3>\r\n                <p>\r\n                  โอเมก้าอยู่ลำดับต่ำสุดในจักรวาลโอเมก้าเวิร์ส โอเมก้าเพศเมียมีโครงสร้างร่างกายทั่วไปไม่จำเป็นต้องมีอะไรพิเศษหรือแปลกใหม่ในระหว่างกระบวนการคลอด ในทางกลับกันโอเมก้าเพศผู้มีอวัยวะสืบพันธุ์เหมือนกับเพศเมีย พวกเขามีกลิ่นที่ดึงดูดอัลฟ่าได้เช่นกัน ในช่วงเวลาหนึ่งพวกเขาจะปล่อยมันออกมามากทำให้ต้องติดแผ่นยับยั้ง บางครั้งอาจกระทบการงานพวกเขา\r\n                </p>\r\n                <a href=\"https://www.wattpad.com/546924059-the-unofficial-guide-to-the-omegaverse-basic\">\r\n                  Read More\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"col-md-6 pr-0\">\r\n        <div class=\"box b2\">\r\n          <div class=\"img-box\">\r\n            <img src=\"images/b4.jpg\" alt=\"\"  >\r\n          </div>\r\n          <div class=\"row\">\r\n            <div class=\"col-lg-8 col-md-10 mr-auto\">\r\n              <div class=\"detail-box\">\r\n                <div class=\"img_date\">\r\n                  <h6>\r\n                    δ\r\n                  </h6>\r\n                </div>\r\n                <h3>\r\n                  Delta\r\n                </h3>\r\n                <p>\r\n                  เดลต้ามีลักษณะคล้ายกับอัลฟ่า แต่มีลักษณะทางพฤติกรรมเท่านั้นหรือก็คือพวกเขาก้าวร้าวและหวงอาณาเขต แต่เมื่ออยู่ร่วมกับอัลฟ่าแล้วพวกเขาจะอยู่ในลำดับที่สองของการเป็นผุ้นำและเป็นมือขวาของอัลฟ่า\r\n                  โดยปกติแล้วจะมีเดลต้าหนึ่งคนในฝูง กลิ่นของพวกเขาไม่แรงเท่าอัลฟ่าแต่ก็ไม่อ่อนเท่าเบต้า และสามารถกระตุ้นโอเมก้าได้\r\n                </p>\r\n                <a href=\"https://www.wattpad.com/546924059-the-unofficial-guide-to-the-omegaverse-basic\">\r\n                  Read More\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"row\">\r\n    <div class=\"col-md-6 pl-0\">\r\n      <div class=\"box b1\">\r\n        <div class=\"img-box\">\r\n          <img src=\"images/b5.png\" alt=\"\">\r\n        </div>\r\n        <div class=\"row\">\r\n          <div class=\"col-lg-8 col-md-10 ml-auto\">\r\n            <div class=\"detail-box\">\r\n              <div class=\"img_date\">\r\n                <h6>\r\n                  Γ\r\n                </h6>\r\n              </div>\r\n              <h3>\r\n                Gamma\r\n              </h3>\r\n              <p>\r\n                แกมม่าโดยพื้นฐานแล้วคือเบต้าที่มีลักษณะเฉพาะของโอเมก้า อย่างไรก็ตาม พวกเขาไม่สามารถรับกลิ่นของอัลฟ่า แกมมา และโอเมก้าได้ \r\n                เว้นแต่จะเป็นโอเมก้าในช่วงติดสัดหรืออัลฟ่าในช่วงติดสัด อย่างไรก็ตาม พวกเขาไม่เหมือนกับมนุษย์เนื่องจากพวกเขายังคงมีลักษณะหลายอย่างที่คล้ายกับโอเมก้า ซึ่งก็คือยอมจำนนต่อเบต้า เดลต้า และอัลฟ่า\r\n                ยกเว้นโอเมก้า พวกเขาเกี่ยวข้องกับโอเมก้า เนื่องจากมีสัญชาตญาณความเป็นแม่ที่แรงกล้าแม้ว่าจะเป็นเพศผู้หรือเพศเมียก็ตาม\r\n              </p>\r\n              <a href=\"https://www.wattpad.com/546924059-the-unofficial-guide-to-the-omegaverse-basic\">\r\n                Read More\r\n              </a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"col-md-6 pr-0\">\r\n      <div class=\"box b2\">\r\n        <div class=\"img-box\">\r\n          <img src=\"images/b6.jpg\" alt=\"\">\r\n        </div>\r\n        <div class=\"row\">\r\n          <div class=\"col-lg-8 col-md-10 mr-auto\">\r\n            <div class=\"detail-box\">\r\n              <div class=\"img_date\">\r\n                <h6>\r\n                  E\r\n                </h6>\r\n              </div>\r\n              <h3>\r\n                Enigma\r\n              </h3>\r\n              <p>\r\n                เป็นเพศที่หายากที่สุด มีความแข็งแกร่ง สติปัญญาที่เหนือกว่าและไม่มีใครสามารถต้านทานเสน่ห์ของพวกเขาได้ โดยพื้นฐานแล้วพวกเขาเป็นเพศที่ดีที่สุด พวกเขามีพฤติกรรมคล้ายอัลฟ่า ก้าวร้าวและควบคุมหลาอย่างได้มากกว่าอัลฟ่าตัวจริงด้วยซ้ํา พวกเขาไม่ก้มหัวต่อใครและไม่ยอมจํานน พวกเขาสามารถบังคับบัญชาได้ทุกเพศรวมถึงอัลฟ่า \r\n                สามารถทําให้ทุกเพศตั้งครรภ์ได้ รวมถึงอัลฟ่าตัวเมียด้วย<br>\r\n                กลิ่นของพวกเขาไม่สามารถแทนที่โอเมก้าได้ แต่พวกเขาสามารถต้านทานฟีโรโมนของโอเมก้าได้ ซึ่งแตกต่างจากอัลฟ่าที่จะเข้าสู่ความต้องการหากพวกเขาได้กลิ่นฟีโรโมนของโอเมก้า\r\n              </p>\r\n              <a href=\"https://aminoapps.com/c/yaoiiomegaverse/page/item/enigmas/wMKQ_LeCpIW1637DKd6w0R44jxZ8dYD3qm\">\r\n                Read More\r\n              </a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"row\">\r\n      </div>\r\n      <div class=\"col-md-6 pl-0\">\r\n        <div class=\"box b1\">\r\n          <div class=\"img-box\">\r\n            <img src=\"./images/b7.jpg\" alt=\"\">\r\n          </div>\r\n          <div class=\"row\">\r\n            <div class=\"col-lg-8 col-md-10 ml-auto\">\r\n              <div class=\"detail-box\">\r\n                <div class=\"img_date\">\r\n                  <h6>\r\n                    Σ\r\n                  </h6>\r\n                </div>\r\n                <h3>\r\n                  Sigma\r\n                </h3>\r\n                <p>\r\n                  เป็นโอเมก้าที่โดดเด่นในจักรวาลโอเมก้าเวิร์ส พวกเขาก้าวร้าวพอๆกับอัลฟ่าและมักจะต่อสู้กัน <br/>\r\n                  ในวัยเด็กซิกม่าและอัลฟ่ามักจะต่อสู้กันเอง แต่เนื่องจากซิกม่าเป็นโอเมก้าในทางชีวภาพ พวกเขาจึงยังอ่อนแอกว่าอัลฟ่าอยู่ <br/>\r\n                  พวกเขามีอาการเหมือนกับโอเมก้าทั่วไป แต่พวกเขามีความก้าวร้าวน้อยกว่าทั้งในความเจ็บปวดทางร่างกายและความเครียดทางจิตใจ อย่างไรก็ตาม พฤติกรรมของซิกม่าจะก้าวร้าวมากขึ้นเมื่อเทียบกับโอเมก้า<br/>\r\n                  สถานะทางชีวภาพของพวกเขาเป็นโอเมก้าตัวผู้และตัวเมียจึงสามารถดูแลเด็กได้แต่ไม่สามารถตั้งครรภ์ได้  ในบางกรณีซิกม่าเพศผู้สามารถทําให้ซิกม่าเพศเมียตั้งครรภ์ได้ แม้จะโอกาสน้อย \r\n                </p>\r\n                <a href=\"https://aminoapps.com/c/omegaverse608/page/item/sigma/dKx6_KrtaIEaYkwDJL6VdKp8Ev8XnVqj41\">\r\n                  Read More\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"col-md-6 pr-0\">\r\n        <div class=\"box b2\">\r\n          <div class=\"img-box\">\r\n            <img src=\"images/b8.jpg\" alt=\"\">\r\n          </div>\r\n          <div class=\"row\">\r\n            <div class=\"col-lg-8 col-md-10 mr-auto\">\r\n              <div class=\"detail-box\">\r\n                <div class=\"img_date\">\r\n                  <h6>\r\n                    Θ\r\n                  </h6>\r\n                </div>\r\n                <h3>\r\n                  Theta\r\n                </h3>\r\n                <p>\r\n                  ได้รับการพิจารณาว่าอันตรายต่อลำดับชั้นอื่น พวกเขาเกิดจากการกลายพันธุ์มีกลิ่นที่ผ่อนคลาย จึงได้รับการคัดเลือกจากกองทัพเป็นทหารเพราะลักษณะนี้<br/>\r\n                  เทต้าจึงจําเป็นต้องใช้ยาที่ปิดกั้นกลิ่น\r\n                  พวกเขาเกิดมามีบุตรยากหรือเป็นหมัน ทําให้เทต้าไม่สามารถผลิตลูกได้โดยตรง พวกเขามักเป็นลูกหลานของพ่อแม่เบต้าสองคนที่มีการกลายพันธุ์ทางพันธุกรรมเป็นยีนด้อยในสายเลือด<br>\r\n                </p>\r\n                <a href=\"https://aminoapps.com/c/yaoiiomegaverse/page/item/thetas/6bPn_zBCYIBQ1ngG0D8BbZGDZ3Jval70n\">\r\n                  Read More\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"row\">\r\n      </div>\r\n      <div class=\"col-md-6 pl-0\">\r\n        <div class=\"box b1\">\r\n          <div class=\"img-box\">\r\n            <img src=\"./images/b9.jpg\" alt=\"\">\r\n          </div>\r\n          <div class=\"row\">\r\n            <div class=\"col-lg-8 col-md-10 ml-auto\">\r\n              <div class=\"detail-box\">\r\n                <div class=\"img_date\">\r\n                  <h6>\r\n                    I\r\n                  </h6>\r\n                </div>\r\n                <h3>\r\n                  Iota\r\n                </h3>\r\n                <p>\r\n                  เป็นการผสมระหว่างโอเมก้าและเบต้า พวกเขามีฟันที่แหลมคมและกลิ่นหอมของเบต้า พวกเขามักจะจับคู่กับเอปซิลอนหรือไอโอต้าด้วยกันเอง<br/>\r\n                  เนื่องจากลักษณะที่ก้าวร้าว พวกเขาจึงถูกบังคับหรือหลอกให้ยอมจํายอม<br/>\r\n                  ไอโอต้ามีอวัยวะเพศเดียวกันกับโอเมก้าแต่ตัวผู้สามารถทําให้ผู้หญิงตั้งครรภ์และยังมรอวัยวะเพศผู้ร่วมกับรังไข่ และพวกเขายังมีอาการช่วงสัดเหมือนโอเมก้าแต่ไม่แสดงออกมากและสั้นกว่า<br/>\r\n                  \r\n                </p>\r\n                <a href=\"https://aminoapps.com/c/omegaverse346/page/item/iota/a8je_ggH8IevqM51ZLZYMzYq7EnK70MPpG\">\r\n                  Read More\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"col-md-6 pr-0\">\r\n        <div class=\"box b2\">\r\n          <div class=\"img-box\">\r\n            <img src=\"images/b10.jpg\" alt=\"\">\r\n          </div>\r\n          <div class=\"row\">\r\n            <div class=\"col-lg-8 col-md-10 mr-auto\">\r\n              <div class=\"detail-box\">\r\n                <div class=\"img_date\">\r\n                  <h6>\r\n                    E\r\n                  </h6>\r\n                </div>\r\n                <h3>\r\n                  Epsilon\r\n                </h3>\r\n                <p>\r\n                  เป็นการผสมระหว่างอัลฟ่าและเบต้าและมันเกิดขึ้นกับพ่อแม่อัลฟ่าและเบต้าเท่านั้น พวกเขาคล้ายกับอัลฟ่าในอวัยวะเพศ แต่มีฟันที่แหลมคมและกลิ่นหอมของเบต้า ก้าวร้าวกว่าอัลฟ่า<br/>\r\n                  พวกเขาฉลาดและไม่น่าไว้ใจนักในหลายครั้ง มีความลึกลับสูง<br/>\r\n                  ส่วนใหญ่มีบุตรยากหรือไม่มีน้ำเชื้อตั้งแต่แรกเกิดทําให้พวกเขาไร้ความสามารถในการผลิต บางคนตั้งครรภ์ได้แค่ความสำเร็จต่ำ<br/>\r\n\r\n                </p>\r\n                <a href=\"https://aminoapps.com/c/yaoiiomegaverse/page/item/epsilon/Dx84_51fNIx5DLjlp7djqxmrxEvM05Nr5x\">\r\n                  Read More\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"row\">\r\n      </div>\r\n      <div class=\"col-md-6 pl-0\">\r\n        <div class=\"box b1\">\r\n          <div class=\"img-box\">\r\n            <img src=\"./images/b11.jpg\" alt=\"\">\r\n          </div>\r\n          <div class=\"row\">\r\n            <div class=\"col-lg-8 col-md-10 ml-auto\">\r\n              <div class=\"detail-box\">\r\n                <div class=\"img_date\">\r\n                  <h6>\r\n                    Z\r\n                  </h6>\r\n                </div>\r\n                <h3>\r\n                  Zeta\r\n                </h3>\r\n                <p>\r\n                  โอกาสเกิดได้น้อย เซต้าคือคนที่สามารถเปลี่ยนแปลงทางกายวิภาคศาสตร์ได้ว่าจะเป็นโอเมก้าหรืออัลฟ่าขึ้นอยู่กับคู่หรืออารมณ์<br/>\r\n                  สามารถเกิดมาได้จากเซต้าสองคนหรืออัลฟ่าและโอเมก้าหรือพ่อแม่อย่างน้อยหนึ่งคนเป็นเซต้า<br/>\r\n                  กลิ่นของพวกเขาแตกต่างกันไปตามความต้องการ พวกเขาเปลี่ยนไปใช้กลิ่นแบบอ่อนโยนในขณะที่เป็นโอเมก้า และเข้มข้นในขณะที่เป็นอัลฟ่า\r\n                </p>\r\n                <a href=\"https://aminoapps.com/c/yaoiiomegaverse/page/item/zeta-info/e1YQ_LVC6IKX1wN6BkDG25rb1R5mBb6rvp\">\r\n                  Read More\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    \r\n    </div>\r\n  </div>\r\n</div>\r\n  </div>\r\n  </section>\r\n\r\n\r\n\r\n  <!-- end blog section -->\r\n\r\n\r\n\r\n<!-- client section -->\r\n<section class=\"client_section layout_padding-bottom\">\r\n  <div class=\"container-fluid\">\r\n    <div class=\"row\">\r\n      <div class=\"col-md-10 col-lg-8 mx-auto\">\r\n        <div class=\"client_container\">\r\n          <div class=\"heading_container\">\r\n            <h2>\r\n              Locked Image\r\n            </h2>\r\n            <p>\r\n              อิมเมจที่ทางสต๊าฟล็อคเอาไว้\r\n            </p>\r\n          </div>\r\n          <div class=\"client_box-container\">\r\n            <div class=\"carousel-wrap \">\r\n              <div class=\"owl-carousel\">\r\n\r\n                <div class=\"item\">\r\n                  <div class=\"box\">\r\n                    <div class=\"img-box\">\r\n                      <img src=\"images/client1.jpg\" alt=\"\" />\r\n                    </div>\r\n                    <div class=\"detail-box\">\r\n                      <h4>\r\n                        Marco Reus\r\n                      </h4>\r\n                      <p>\r\n                        \"Zwei Dinge sind unendlich, das Universum und die menschliche Dummheit, aber bei dem Universum bin ich mir noch nicht ganz sicher\"\r\n                      </p>\r\n                      <img src=\"images/quote.png\" alt=\"\" />\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n\r\n                <div class=\"item\">\r\n                  <div class=\"box\">\r\n                    <div class=\"img-box\">\r\n                      <img src=\"images/client2.jpg\" alt=\"\" />\r\n                    </div>\r\n                    <div class=\"detail-box\">\r\n                      <h4>\r\n                        Francisco \"